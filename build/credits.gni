# about:credits for //ghost's third-party code and data. Chromium's
# licenses.py finds only directories under its own third_party/, so these are
# named: the vendored crates (generated by tools/rust_vendor.py) and the
# filter lists. components/resources/BUILD.gn imports this (patches/0031) and
# passes the list to licenses.py, through the variable Chromium leaves for
# downstream projects.

import("//ghost/third_party/rust/notice_dirs.gni")

extra_third_party_notice_dirs =
    ghost_rust_notice_dirs + [ "ghost/components/blocking/data" ]
