# Development build: fast to link, symbols for our code and chrome only.
# Use with: gn gen out/vanilla --args='import("//ghost/build/args/dev.gn")'
# (out/vanilla keeps its name: renaming an output directory discards the
# build state, see docs/build/windows.md.)

is_debug = false
is_component_build = true
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0

# Product name, company and copyright in version resources and About.
branding_file_path = "//ghost/branding/BRANDING"

# Non-official builds otherwise activate the experiments listed in
# testing/variations/fieldtrial_testing_config.json. Dev builds must behave
# like releases, or tests and the egress audit measure experiments that ship
# to nobody: HttpsFirstBalancedModeAutoEnable, for one, is switched on there.
disable_fieldtrial_testing_config = true
