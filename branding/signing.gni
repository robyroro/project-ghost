declare_args() {
  # The keys the build pins (branding/keys/<identity>.h): "dev", the
  # committed development keys, or "test", the test identity's keys from
  # its key ceremony (docs/signing/).
  ghost_signing_identity = "dev"
}

assert(ghost_signing_identity == "dev" || ghost_signing_identity == "test",
       "ghost_signing_identity is \"dev\" or \"test\"")
