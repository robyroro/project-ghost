import("//build/buildflag_header.gni")
import("//build/config/chrome_build.gni")
import("//ghost/branding/signing.gni")

# The installer's strings, with the product named from the branding file
# (installer_strings.py). //chrome/installer/util:strings compiles this file in
# place of the one generate_strings writes (patches/0010).
action("installer_strings") {
  visibility = [ "//chrome/installer/util:strings" ]
  script = "installer_strings.py"

  _generated = "$root_gen_dir/chrome/installer/util/installer_util_strings.rc"
  inputs = [
    _generated,
    branding_file_path,
  ]
  outputs = [ "$target_gen_dir/installer_util_strings.rc" ]
  args = [
    "--branding",
    rebase_path(branding_file_path, root_build_dir),
    "--header",
    "chrome/installer/util/installer_util_strings.h",
    rebase_path(_generated, root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]

  deps = [ "//chrome/installer/util:generate_strings" ]
}

buildflag_header("signing_buildflags") {
  header = "signing_buildflags.h"
  _test_identity = ghost_signing_identity == "test"
  flags = [ "GHOST_SIGNING_IDENTITY_TEST=$_test_identity" ]
}

# The updater's keys, compiled into update_client and crx_file
# (patches/0018, 0020): those of the identity ghost_signing_identity names.
source_set("keys") {
  sources = [
    "crx_publisher_key.h",
    "cup_key.h",
    "keys/dev.h",
  ]
  public_deps = [ ":signing_buildflags" ]
}
