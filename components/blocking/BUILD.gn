# The blocking engine (docs/adr/0006-blocking-engine-adblock-rust.md).

import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")

source_set("registrable_domain") {
  sources = [
    "registrable_domain.cc",
    "registrable_domain.h",
  ]
  public_deps = [ "//build/rust:cxx_cppdeps" ]
  deps = [
    "//net",
    "//url",
  ]
}

source_set("blocking") {
  sources = [
    "blocking_engine.cc",
    "blocking_engine.h",
    "filter_lists.cc",
    "filter_lists.h",
    "request_types.cc",
    "request_types.h",
  ]
  public_deps = [
    ":registrable_domain",
    "//base",
    "//services/network/public/mojom:mojom_shared",
    "//url",
  ]
  deps = [ "//ghost/components/blocking/rust:engine" ]
  data_deps = [ ":filter_lists" ]
}

# The lists the browser ships, as data files beside it (docs/licensing.md):
# <out>/blocking/ in a build; the installer takes them from there
# (patches/0030).
copy("filter_lists") {
  sources = [
    "data/easylist.txt",
    "data/easyprivacy.txt",
  ]
  outputs = [ "$root_out_dir/blocking/{{source_file_part}}" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "blocking_engine_unittest.cc",
    "engine_bridge_unittest.cc",
    "filter_lists_unittest.cc",
    "registrable_domain_unittest.cc",
    "request_types_unittest.cc",
  ]
  deps = [
    ":blocking",
    ":registrable_domain",
    "//base/test:test_support",
    "//ghost/components/blocking/rust:engine",
    "//testing/gtest",
  ]
}

# Its own binary, beside ghost_unittests (which depends on //chrome/browser),
# so it builds in minutes in an official output directory, where the budget
# is judged.
test("ghost_blocking_perftests") {
  data = [ "test/request_corpus.tsv" ]
  sources = [ "blocking_perftest.cc" ]
  deps = [
    ":blocking",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//ghost/components/blocking/rust:engine",
    "//testing/gtest",
  ]
}

# libFuzzer, in a fuzzing build (docs/testing.md); elsewhere, nothing.
fuzzer_test("ghost_blocking_list_fuzzer") {
  sources = [ "fuzz/blocking_list_fuzzer.cc" ]
  deps = [
    "//base",
    "//ghost/components/blocking/rust:engine",
  ]
  dict = "fuzz/filter_list.dict"
}

fuzzer_test("ghost_blocking_request_fuzzer") {
  sources = [ "fuzz/blocking_request_fuzzer.cc" ]
  deps = [
    ":blocking",
    "//base",
    "//ghost/components/blocking/rust:engine",
  ]
}
