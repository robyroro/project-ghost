# What a site is, for every Shade protection that asks.

source_set("site") {
  sources = [
    "registrable_domain.cc",
    "registrable_domain.h",
  ]
  deps = [
    "//net",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "registrable_domain_unittest.cc" ]
  deps = [
    ":site",
    "//testing/gtest",
  ]
}
