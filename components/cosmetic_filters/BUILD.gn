import("//testing/libfuzzer/fuzzer_test.gni")

# Cosmetic filtering's logic that needs no browser
# (docs/superpowers/specs/2026-10-11-cosmetic-filtering-design.md).
source_set("cosmetic_filters") {
  sources = [
    "names.cc",
    "names.h",
    "procedural.cc",
    "procedural.h",
    "style_sheet.cc",
    "style_sheet.h",
  ]
  deps = [ "//base" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "names_unittest.cc",
    "procedural_unittest.cc",
    "style_sheet_unittest.cc",
  ]
  deps = [
    ":cosmetic_filters",
    "//testing/gtest",
  ]
}

# libFuzzer, in a fuzzing build (docs/testing.md); elsewhere, nothing.
fuzzer_test("ghost_cosmetic_procedural_fuzzer") {
  sources = [ "fuzz/procedural_fuzzer.cc" ]
  deps = [ ":cosmetic_filters" ]
}
