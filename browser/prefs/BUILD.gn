# Linked into //chrome/browser/prefs:impl, whose RegisterProfilePrefs()
# registers Ghost's own prefs (patches/0032), then overrides upstream defaults
# (patches/0002). Must not depend on //chrome/browser, which depends on it. //extensions/browser is needed only for its pref names;
# upstream offers no smaller target for them, and it never depends on chrome.
source_set("prefs") {
  sources = [
    "pref_defaults.cc",
    "pref_defaults.h",
    "profile_prefs.cc",
    "profile_prefs.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/preloading:prefs",
    "//chrome/common:constants",
    "//components/content_settings/core/browser:cookie_settings",
    "//components/content_settings/core/common",
    "//components/password_manager/core/common",
    "//components/pref_registry",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/translate/core/browser:translate_pref_names",
    "//extensions/browser",
    "//ghost/browser/query_filter:prefs",
    "//third_party/blink/public/common",
  ]
}
