# Linked into //chrome/browser:core, whose ChromeBrowserMainParts::Create()
# adds ghost::BrowserMainExtraParts (patches/0005). Must not depend on
# //chrome/browser, which depends on it; the extra-parts interface has its own
# header-only target for that reason.
source_set("startup") {
  sources = [
    "browser_main_extra_parts.cc",
    "browser_main_extra_parts.h",
  ]

  public_deps = [ "//chrome/browser:main_extra_parts" ]

  deps = [
    "//base",
    "//chrome/common:non_code_constants",
    "//ghost/browser/blocking",
  ]
}
