# Request filtering. Linked into //chrome/browser:core (patches/0029), whose
# content browser client installs the filter, and into //ghost/browser/startup,
# which starts the service; so it must not depend on //chrome/browser.
source_set("blocking") {
  sources = [
    "blocking_service.cc",
    "blocking_service.h",
    "request_filter.cc",
    "request_filter.h",
  ]
  public_deps = [
    "//ghost/components/blocking",
    "//mojo/public/cpp/bindings",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
  deps = [
    "//base",
    "//net",
    "//url",
  ]
}
