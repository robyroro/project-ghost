import("//ui/webui/resources/tools/build_webui.gni")

# chrome://protections.top-chrome, the protections panel. Its pak is packed
# into the browser's resources by chrome/chrome_paks.gni (patches/0036).
build_webui("resources") {
  grd_prefix = "protections"
  grit_output_dir = "$root_gen_dir/ghost"

  static_files = [ "protections.html" ]

  ts_files = [
    "app.html.ts",
    "app.ts",
    "browser_proxy.ts",
  ]

  mojo_files_deps = [ "//ghost/browser/ui/protections:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/ghost/browser/ui/protections/protections.mojom-webui.ts" ]

  ts_composite = true
  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"
}
