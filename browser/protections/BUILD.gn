# What the protections panel shows for a tab. Linked into
# //chrome/browser:core through //ghost/browser/blocking, whose filters
# count their blocks here: so it must not depend on //chrome/browser.
source_set("protections") {
  sources = [
    "page_protections.cc",
    "page_protections.h",
    "panel_state.cc",
    "panel_state.h",
  ]

  public_deps = [
    "//base",
    "//content/public/browser",
    "//ghost/components/privacy_policy",
  ]

  deps = [
    "//ghost/browser/privacy_policy",
    "//ghost/components/site",
    "//url",
  ]
}
