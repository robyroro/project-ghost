# Tracking-parameter stripping on navigations. Linked into
# //chrome/browser:core and, for the pref, //chrome/browser/prefs:impl
# (patches/0032), so it must not depend on //chrome/browser.

source_set("prefs") {
  sources = [
    "prefs.cc",
    "prefs.h",
  ]
  deps = [ "//components/pref_registry" ]
}

source_set("query_filter") {
  sources = [
    "query_filter_throttle.cc",
    "query_filter_throttle.h",
  ]
  public_deps = [
    "//ghost/components/query_filter",
    "//third_party/blink/public/common",
    "//url",
  ]
  deps = [
    ":prefs",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
}
