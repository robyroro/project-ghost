# Per-site protection levels in the profile's prefs. Linked into
# //chrome/browser:core (through blocking and the query filter) and
# //chrome/browser/prefs:impl (the pref's registration), so it must not depend
# on //chrome/browser.

source_set("privacy_policy") {
  sources = [
    "site_levels.cc",
    "site_levels.h",
  ]
  public_deps = [ "//ghost/components/privacy_policy" ]
  deps = [
    "//base",
    "//components/pref_registry",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//ghost/browser/query_filter:prefs",
    "//ghost/components/site",
    "//url",
  ]
}
