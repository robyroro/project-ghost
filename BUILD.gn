import("//testing/test.gni")

# Everything //ghost contributes to the default build; the root gn_all group
# depends on this through patches/0001.
group("gn_all") {
  testonly = true
  deps = [
    ":ghost_browsertests",
    ":ghost_unittests",
    "//ghost/components/blocking:ghost_blocking_list_fuzzer",
    "//ghost/components/blocking:ghost_blocking_perftests",
    "//ghost/components/blocking:ghost_blocking_request_fuzzer",
    "//ghost/components/query_filter:ghost_query_filter_fuzzer",
  ]
}

test("ghost_unittests") {
  sources = [
    "browser/component_updater/component_update_urls_unittest.cc",
    "browser/prefs/pref_defaults_unittest.cc",
    "browser/query_filter/prefs_unittest.cc",
    "browser/startup/browser_main_extra_parts_unittest.cc",
    "components/signin/gaia_cookie_manager_service_unittest.cc",
    "components/update_client/request_scrubber_unittest.cc",
    "updater/crx_verifier_unittest.cc",
    "updater/cup_unittest.cc",
    "version/installed_version_poller_unittest.cc",
    "version/version_unittest.cc",
  ]

  deps = [
    "//chrome/browser",
    "//chrome/browser/component_updater",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/preloading:prefs",
    "//chrome/browser/upgrade_detector:impl",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//chrome/test:test_support_unit",
    "//components/autofill/core/common",
    "//components/client_update_protocol",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/crx_file",
    "//components/password_manager/core/browser/leak_detection",
    "//components/password_manager/core/common",
    "//components/prefs",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/signin/public/identity_manager",
    "//components/signin/public/identity_manager:test_support",
    "//components/translate/core/browser",
    "//components/translate/core/browser:translate_pref_names",
    "//components/update_client",
    "//components/version_info",
    "//content/test:test_support",
    "//extensions/browser",
    "//ghost/branding:keys",
    "//ghost/components/blocking:unit_tests",
    "//ghost/components/query_filter:unit_tests",
    "//ghost/components/site:unit_tests",
    "//ghost/browser/query_filter:prefs",
    "//ghost/browser/startup",
    "//ghost/components/update_client:request_scrubber",
    "//ghost/version",
    "//services/network:test_support",
    "//testing/gtest",
    "//url",
  ]

  # ChromeUnitTestSuite loads chrome's resource paks at startup.
  data_deps = [ "//chrome:packed_resources" ]

  # CRX3 fixtures, the CUP vector and the golden update requests.
  data = [ "//ghost/test/updater/" ]
}

# Tests that need chrome's real startup sequence (feature list creation,
# profile creation). Modelled on upstream's browser_tests.
test("ghost_browsertests") {
  sources = [
    "browser/blocking/request_filter_browsertest.cc",
    "browser/query_filter/query_filter_browsertest.cc",
    "browser/features/feature_overrides_browsertest.cc",
    "test/egress/omnibox_browsertest.cc",
    "test/google_services_browsertest.cc",
    "test/network_defaults_browsertest.cc",
    "test/web_version_browsertest.cc",
  ]

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  deps = [
    "//base",
    "//chrome/browser",
    "//chrome/browser:browser_process",
    "//chrome/browser/autocomplete:aim_eligibility_service",
    "//chrome/browser/gcm",
    "//chrome/browser/interstitials:test_support",
    "//chrome/browser/media/router:media_router_feature",
    "//chrome/browser/privacy_sandbox:headers",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search",
    "//chrome/browser/search_engines",
    "//chrome/browser/ssl",
    "//chrome/browser/ui",
    "//chrome/browser/ui/location_bar",
    "//chrome/browser/ui/omnibox",
    "//chrome/browser/ui/webui/version",
    "//chrome/common",
    "//chrome/test:browser_tests_runner",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:browser_feature_test_waiters",
    "//components/autofill/content/browser",
    "//components/autofill/core/browser",
    "//components/gcm_driver",
    "//components/gcm_driver:test_support",
    "//components/network_time",
    "//components/omnibox/browser",
    "//components/privacy_sandbox:privacy_sandbox_settings_headers",
    "//components/regional_capabilities",
    "//components/search_engines",
    "//content/test:test_support",
    "//ghost/browser/blocking",
    "//ghost/browser/query_filter",
    "//ghost/browser/query_filter:prefs",
    "//ghost/version",
    "//net:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]

  data_deps = [ "//chrome:packed_resources" ]

  if (is_win) {
    configs += [ "//build/config/win:delayloads" ]
    deps += [ "//chrome/installer/util:strings" ]
  }
}
