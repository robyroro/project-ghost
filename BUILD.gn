import("//testing/test.gni")

# Everything //ghost contributes to the default build; the root gn_all group
# depends on this through patches/0001.
group("gn_all") {
  testonly = true
  deps = [
    ":ghost_browsertests",
    ":ghost_unittests",
  ]
}

test("ghost_unittests") {
  sources = [ "browser/prefs/pref_defaults_unittest.cc" ]

  deps = [
    "//chrome/browser",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/preloading:prefs",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//chrome/test:test_support_unit",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/prefs",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/translate/core/browser",
    "//components/translate/core/browser:translate_pref_names",
    "//content/test:test_support",
    "//extensions/browser",
    "//testing/gtest",
  ]

  # ChromeUnitTestSuite loads chrome's resource paks at startup.
  data_deps = [ "//chrome:packed_resources" ]
}

# Tests that need chrome's real startup sequence (feature list creation,
# profile creation). Modelled on upstream's browser_tests.
test("ghost_browsertests") {
  sources = [ "browser/features/feature_overrides_browsertest.cc" ]

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  deps = [
    "//base",
    "//chrome/browser",
    "//chrome/browser:browser_process",
    "//chrome/browser/autocomplete:aim_eligibility_service",
    "//chrome/browser/media/router:media_router_feature",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ssl",
    "//chrome/test:browser_tests_runner",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/network_time",
    "//components/omnibox/browser",
    "//content/test:test_support",
    "//testing/gtest",
  ]

  data_deps = [ "//chrome:packed_resources" ]

  if (is_win) {
    configs += [ "//build/config/win:delayloads" ]
    deps += [ "//chrome/installer/util:strings" ]
  }
}
