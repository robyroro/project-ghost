From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: robyroro <41092915+robyroro@users.noreply.github.com>
Date: Fri, 2 Oct 2026 18:51:01 +0300
Subject: [PATCH] crx_file: add a format that requires Ghost's publisher proof

CRX3_WITH_GHOST_PUBLISHER_PROOF accepts a CRX3 only with a proof by one of
the keys whose hashes are in //ghost/branding/crx_publisher_key.h: Ghost's
primary publisher key and its backup. The existing formats, including the
Web Store's, are unchanged.

Why: the publisher key is a constant in crx_verifier.cc.
Upstream: not upstreamable: product-specific signing key
Signed-off-by: robyroro <41092915+robyroro@users.noreply.github.com>

diff --git a/components/crx_file/BUILD.gn b/components/crx_file/BUILD.gn
index 27d93175c2eaa99d35ffd0a99e9609a9f894a29b..454f4f85bcea52519997ab05cc6d60775e6fcaf3 100644
--- a/components/crx_file/BUILD.gn
+++ b/components/crx_file/BUILD.gn
@@ -16,6 +16,7 @@ static_library("crx_file") {
   deps = [
     "//base",
     "//crypto",
+    "//ghost/branding:keys",
   ]
 
   public_deps = [ ":crx3_proto" ]
diff --git a/components/crx_file/crx_verifier.cc b/components/crx_file/crx_verifier.cc
index 77a54cf32c477e4a47334db41eaab0d7fa64675e..79f7464fcf6affc46e9b04181135d6cff2e0aff9 100644
--- a/components/crx_file/crx_verifier.cc
+++ b/components/crx_file/crx_verifier.cc
@@ -28,6 +28,7 @@
 #include "crypto/keypair.h"
 #include "crypto/secure_util.h"
 #include "crypto/sign.h"
+#include "ghost/branding/crx_publisher_key.h"
 
 namespace crx_file {
 
@@ -110,7 +111,8 @@ VerifierResult VerifyCrx3(
     std::string* crx_id,
     std::vector<uint8_t>* compressed_verified_contents,
     bool require_publisher_key,
-    bool accept_publisher_test_key) {
+    bool accept_publisher_test_key,
+    bool accept_only_ghost_publisher_key) {
   // Parse [header-size] and [header].
   int header_size =
       base::saturated_cast<int>(ReadAndHashLittleEndianUInt32(file, hash));
@@ -192,8 +194,12 @@ VerifierResult VerifyCrx3(
       auto key_hash = crypto::hash::Sha256(key);
       required_key_set.erase(key_hash);
       found_publisher_key =
-          found_publisher_key || key_hash == kPublisherKeyHash ||
-          (accept_publisher_test_key && key_hash == kPublisherTestKeyHash);
+          found_publisher_key ||
+          (accept_only_ghost_publisher_key
+               ? std::ranges::contains(ghost::kCrxPublisherKeyHashes, key_hash)
+               : (key_hash == kPublisherKeyHash ||
+                  (accept_publisher_test_key &&
+                   key_hash == kPublisherTestKeyHash)));
       std::optional<crypto::keypair::PublicKey> pub_key =
           crypto::keypair::PublicKey::FromSubjectPublicKeyInfo(
               base::as_byte_span(key));
@@ -276,11 +282,13 @@ VerifierResult Verify(
   if (version == 3) {
     bool require_publisher_key =
         format == VerifierFormat::CRX3_WITH_PUBLISHER_PROOF ||
-        format == VerifierFormat::CRX3_WITH_TEST_PUBLISHER_PROOF;
+        format == VerifierFormat::CRX3_WITH_TEST_PUBLISHER_PROOF ||
+        format == VerifierFormat::CRX3_WITH_GHOST_PUBLISHER_PROOF;
     result = VerifyCrx3(
         &file, file_hash, required_key_hashes, &public_key_local, &crx_id_local,
         compressed_verified_contents, require_publisher_key,
-        format == VerifierFormat::CRX3_WITH_TEST_PUBLISHER_PROOF);
+        format == VerifierFormat::CRX3_WITH_TEST_PUBLISHER_PROOF,
+        format == VerifierFormat::CRX3_WITH_GHOST_PUBLISHER_PROOF);
   } else {
     result = VerifierResult::ERROR_HEADER_INVALID;
   }
diff --git a/components/crx_file/crx_verifier.h b/components/crx_file/crx_verifier.h
index 0bf25996e1798bca447f7d704b937f4306a1b0a6..8e76a460e52b933ac58cdd7f781f6b1a1152bf2e 100644
--- a/components/crx_file/crx_verifier.h
+++ b/components/crx_file/crx_verifier.h
@@ -21,6 +21,8 @@ enum class VerifierFormat {
                                    // publisher proof.
   CRX3_WITH_PUBLISHER_PROOF,       // Accept only Crx3 with a production
                                    // publisher proof.
+  CRX3_WITH_GHOST_PUBLISHER_PROOF,  // Ghost: accept only Crx3 with Ghost's
+                                    // publisher proof (Ghost's updater).
 };
 
 enum class VerifierResult {
