From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: robyroro <41092915+robyroro@users.noreply.github.com>
Date: Sun, 11 Oct 2026 11:05:45 +0300
Subject: [PATCH] settings: Shade's protections section

chrome://settings gets a "Shade protections" entry above "Privacy and
security", at /protections. The section is a TypeScript library in
//ghost/browser/resources/settings, mapped into the Settings bundle under
/shade/ exactly as upstream maps its settings_shared library under
/shared/settings/ (ts_deps, ts_path_mappings,
optimize_webui_external_paths; its pak packed only when !optimize_webui,
with its grd's resource ids). The route goes in route.ts and router.ts's
SettingsRoutes, the entry in the menu, the view in settings_main, and
SettingsUI calls ghost::settings::SetUpSettingsPage for the section's
strings, resources and handler.

Why: Settings lists its sections, routes and resources itself, with no hook.
Upstream: not upstreamable: product-specific UI
Signed-off-by: robyroro <41092915+robyroro@users.noreply.github.com>

diff --git a/chrome/browser/resources/settings/BUILD.gn b/chrome/browser/resources/settings/BUILD.gn
index 24115ed25cc9130ada7cf5ac572d4da715ba89ac..be611b92bd662651a8ac873755c815ab7f099101 100644
--- a/chrome/browser/resources/settings/BUILD.gn
+++ b/chrome/browser/resources/settings/BUILD.gn
@@ -503,6 +503,7 @@ build_webui("build") {
 
   ts_deps = [
     "//chrome/browser/resources/settings_shared:build_ts",
+    "//ghost/browser/resources/settings:build_ts",
     "//third_party/lit/v3_0:build_ts",
     "//third_party/polymer/v3_0:library",
     "//ui/webui/resources/cr_components/color_change_listener:build_ts",
@@ -524,10 +525,16 @@ build_webui("build") {
     ts_deps += [ "//ash/webui/common/resources:build_ts" ]
   }
 
-  ts_path_mappings =
-      [ "/shared/settings/*|" + rebase_path(
+  ts_path_mappings = [
+    "/shared/settings/*|" + rebase_path(
             "$root_gen_dir/chrome/browser/resources/settings_shared/tsc/*",
-            target_gen_dir) ]
+            target_gen_dir),
+
+    # Shade's section, mapped as settings_shared is (patches/0038).
+    "/shade/*|" + rebase_path(
+            "$root_gen_dir/ghost/browser/resources/settings/tsc/*",
+            target_gen_dir),
+  ]
 
   if (is_chromeos) {
     # TODO(crbug.com/1013466): Browser Settings should not depend on ash/webui/
@@ -547,9 +554,13 @@ build_webui("build") {
     ]
     optimize_webui_excludes =
         [ "chrome://resources/mojo/skia/public/mojom/skcolor.mojom-webui.js" ]
-    optimize_webui_external_paths =
-        [ "/shared/settings|" + rebase_path(
+    optimize_webui_external_paths = [
+      "/shared/settings|" + rebase_path(
               "$root_gen_dir/chrome/browser/resources/settings_shared/tsc",
-              root_build_dir) ]
+              root_build_dir),
+      "/shade|" + rebase_path(
+              "$root_gen_dir/ghost/browser/resources/settings/tsc",
+              root_build_dir),
+    ]
   }
 }
